{{/* Revika: same layout as sign-in. Upstream: upstream/templates/user/auth/twofa.tmpl (v28.4.0). */}}
{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content user signin rv-auth">
	<div class="rv-auth-card">
		<a class="rv-auth-mark" href="{{AppSubUrl}}/" aria-label="{{ctx.Locale.Tr "home_title"}}"><span class="rv-mark"></span></a>
		<h1 class="rv-auth-title">{{ctx.Locale.Tr "twofa"}}</h1>

		{{template "base/alert" .}}

		<form class="ui form rv-auth-form" action="{{.Link}}" method="post">
			<div class="field">
				<label class="rv-sr-only" for="passcode">{{ctx.Locale.Tr "passcode"}}</label>
				<input id="passcode" name="passcode" type="text" placeholder="{{ctx.Locale.Tr "passcode"}}" autocomplete="one-time-code" inputmode="numeric" pattern="[0-9]*" autofocus required>
			</div>
			<button type="submit" class="ui primary button rv-auth-submit">{{ctx.Locale.Tr "auth.verify"}}</button>
		</form>

		<div class="rv-auth-links">
			<a href="{{AppSubUrl}}/user/two_factor/scratch">{{ctx.Locale.Tr "auth.use_scratch_code"}}</a>
		</div>
	</div>
</div>
{{template "base/footer" .}}
